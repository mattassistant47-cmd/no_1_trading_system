# Application Settings
MODE=paper
LOG_LEVEL=INFO
DEBUG=false
APP_NAME=No.1 Trading System
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql+asyncpg://trading_user:trading_password@localhost:5432/trading_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Alpaca Configuration
ALPACA_API_KEY_PAPER=paper_key_here
ALPACA_API_SECRET_PAPER=paper_secret_here
ALPACA_BASE_URL_PAPER=https://paper-api.alpaca.markets

ALPACA_API_KEY_LIVE=live_key_here
ALPACA_API_SECRET_LIVE=live_secret_here
ALPACA_BASE_URL_LIVE=https://api.alpaca.markets

# Interactive Brokers Configuration
IBKR_ACCOUNT_ID=account_id_here
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Polymarket Configuration
POLYMARKET_API_KEY=polymarket_key_here
POLYMARKET_PRIVATE_KEY=polymarket_private_key_here
POLYMARKET_BASE_URL=https://clob.polymarket.com

# FRED API Configuration
FRED_API_KEY=fred_api_key_here

# Trading Configuration
INITIAL_CAPITAL=100000.0
MAX_POSITION_SIZE_PERCENT=0.10
MAX_PORTFOLIO_RISK_PERCENT=0.02
MAX_LEVERAGE=2.0
MIN_CASH_BUFFER_PERCENT=0.05
MAX_SLIPPAGE_PERCENT=0.001

# Strategy Configuration
MOMENTUM_ENABLED=true
MOMENTUM_LOOKBACK=20
MOMENTUM_THRESHOLD=0.05

MEAN_REVERSION_ENABLED=true
MEAN_REVERSION_Z_SCORE=2.0
MEAN_REVERSION_WINDOW=30

CRYPTO_MOMENTUM_ENABLED=false
CRYPTO_MOMENTUM_LOOKBACK=14

OPTIONS_WHEEL_ENABLED=false

POLYMARKET_ENABLED=false

# Scheduler Configuration
SCHEDULER_TIMEZONE=UTC
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0
STRATEGY_CHECK_INTERVAL_SECONDS=300
RISK_CHECK_INTERVAL_SECONDS=60
DATA_SYNC_INTERVAL_SECONDS=60

# Broker Settings
COMMISSION_PER_TRADE=0.0
SLIPPAGE_PERCENT=0.0001

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Monitoring & Logging
PROMETHEUS_PORT=9090
LOG_FILE_PATH=/var/log/trading_system.log
MAX_LOG_SIZE_MB=100
LOG_RETENTION_DAYS=30

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Features
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_RISK_CHECKS=true
ENABLE_POSITION_SIZING=true
ENABLE_PERFORMANCE_TRACKING=true
